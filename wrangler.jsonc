{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toptopaaa-production",
      "database_id": "de9f1fa4-8ddd-4f2a-adf0-9efdb3955255"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORK",
      "bucket_name": "work"
    }
  ],
  "routes": [
    {
      "pattern": "toptopaaa.com",
      "custom_domain": true
    }
  ]
}
